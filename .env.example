# Required: Bearer token used by Custom GPT -> this service.
API_TOKEN=replace-with-a-long-random-secret

# Workspace is a real persistent Git checkout root on the VPS.
WORKSPACE_ROOT=/srv/mygpt/repos
LISTEN_ADDR=127.0.0.1:8787

# Repository APIs are restricted by this allowlist. runCommand is host-wide and
# deliberately does not use this repository restriction.
ALLOWED_REPOS=xiaoqianran/*

# Direct GitHub mode.
GIT_REMOTE_BASE_URL=https://github.com
GIT_REMOTE_USERNAME=x-access-token
GITHUB_TOKEN=

# Optional override for Git transport only.
GIT_REMOTE_TOKEN=

# Commit identity used by native git commit.
GIT_AUTHOR_NAME=MyGPT Workspace Agent
GIT_AUTHOR_EMAIL=mygpt@localhost
GIT_COMMITTER_NAME=MyGPT Workspace Agent
GIT_COMMITTER_EMAIL=mygpt@localhost

# Host command execution.
COMMAND_TIMEOUT_SECONDS=300
MAX_COMMAND_OUTPUT_CHARS=120000

MAX_READ_FILES=50
MAX_PAGE_CHARS=180000
MAX_WRITE_BYTES=5000000
MAX_DIFF_CHARS=180000
