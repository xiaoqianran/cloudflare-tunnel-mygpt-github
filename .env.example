# Required: Bearer credential used by Custom GPT -> this service.
API_TOKEN=replace-with-a-long-random-secret

# Keep the origin private; publish it through Cloudflare Tunnel.
LISTEN_ADDR=127.0.0.1:8787

# Universal host command execution.
COMMAND_TIMEOUT_SECONDS=1800
MAX_COMMAND_OUTPUT_CHARS=180000

# Optional convenience for GitHub CLI. Child commands inherit the root service
# environment; when GITHUB_TOKEN is set and GH_TOKEN is absent, runCommand also
# supplies GH_TOKEN with the same value.
GITHUB_TOKEN=
