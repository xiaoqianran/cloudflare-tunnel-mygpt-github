[Unit]
Description=MyGPT Local Git Workspace Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=HOME=/root
EnvironmentFile=/etc/mygpt-github-agent.env
ExecStart=/usr/local/bin/mygpt-github-agent
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
