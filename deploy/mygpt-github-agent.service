[Unit]
Description=MyGPT VPS Root Shell Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root
Environment=HOME=/root
Environment=USER=root
Environment=LOGNAME=root
Environment=SHELL=/bin/bash
Environment=PATH=/root/.local/bin:/root/.cargo/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
EnvironmentFile=/etc/mygpt-github-agent.env
ExecStart=/usr/local/bin/mygpt-github-agent
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
