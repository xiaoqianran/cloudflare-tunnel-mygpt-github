{
  "openapi": "3.1.0",
  "info": {
    "title": "MyGPT Local Git Workspace",
    "version": "0.2.3",
    "description": "Operate real Git repositories cloned on a private Linux server. Repository reads, searches and writes use the server's local filesystem. runCommand executes shell commands directly on the VPS host as the root service account. Use these actions instead of built-in GitHub tools whenever possible."
  },
  "servers": [{"url": "__SERVER_URL__"}],
  "security": [{"BearerAuth": []}],
  "components": {
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque"}
    },
    "schemas": {
      "RepoRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"repo": {"type": "string", "description": "Repository as owner/name"}},
        "required": ["repo"]
      },
      "FileChange": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "content": {"type": "string"},
          "delete": {"type": "boolean", "default": false}
        },
        "required": ["path"]
      }
    }
  },
  "paths": {
    "/v1/repository/sync": {"post": {"operationId":"syncRepository","x-openai-isConsequential":false,"summary":"Clone or fetch a repository into the local server workspace","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"repo":{"type":"string"},"ref":{"type":"string"}},"required":["repo"]}}}},"responses":{"200":{"description":"Repository synchronized"}}}},
    "/v1/repository/inspect": {"post": {"operationId":"inspectRepository","x-openai-isConsequential":false,"summary":"Inspect local Git state and list repository files","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"repo":{"type":"string"},"path_prefix":{"type":"string"},"cursor":{"type":"string"},"limit":{"type":"integer","minimum":1,"maximum":5000}},"required":["repo"]}}}},"responses":{"200":{"description":"Local repository state and file list"}}}},
    "/v1/files/read": {"post": {"operationId":"readFiles","x-openai-isConsequential":false,"summary":"Read multiple files directly from the local repository","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"repo":{"type":"string"},"paths":{"type":"array","minItems":1,"maxItems":50,"items":{"type":"string"}}},"required":["repo","paths"]}}}},"responses":{"200":{"description":"Local file contents"}}}},
    "/v1/repository/search": {"post": {"operationId":"searchRepository","x-openai-isConsequential":false,"summary":"Search repository contents locally","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"repo":{"type":"string"},"query":{"type":"string"},"path_prefix":{"type":"string"},"regex":{"type":"boolean"},"limit":{"type":"integer"}},"required":["repo","query"]}}}},"responses":{"200":{"description":"Search matches"}}}},
    "/v1/repository/page": {"post": {"operationId":"readRepositoryPage","x-openai-isConsequential":false,"summary":"Walk the complete text repository under a response budget","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"repo":{"type":"string"},"path_prefix":{"type":"string"},"cursor":{"type":"string"},"max_chars":{"type":"integer"},"max_files":{"type":"integer"}},"required":["repo"]}}}},"responses":{"200":{"description":"Repository page and next cursor"}}}},
    "/v1/files/apply": {"post": {"operationId":"applyChanges","x-openai-isConsequential":false,"summary":"Write or delete files in the local repository","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"repo":{"type":"string"},"changes":{"type":"array","minItems":1,"items":{"$ref":"#/components/schemas/FileChange"}}},"required":["repo","changes"]}}}},"responses":{"200":{"description":"Local changes applied"}}}},
    "/v1/git/diff": {"post": {"operationId":"gitDiff","x-openai-isConsequential":false,"summary":"Read the local Git diff","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"repo":{"type":"string"},"staged":{"type":"boolean"},"max_chars":{"type":"integer"}},"required":["repo"]}}}},"responses":{"200":{"description":"Git diff"}}}},
    "/v1/git/commit-push": {"post": {"operationId":"commitAndPush","x-openai-isConsequential":false,"summary":"Commit all local changes and push with native Git","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"repo":{"type":"string"},"message":{"type":"string"},"branch":{"type":"string"},"force":{"type":"boolean"}},"required":["repo"]}}}},"responses":{"200":{"description":"Commit and push result"}}}},
    "/v1/github/release": {"post": {"operationId":"createRelease","x-openai-isConsequential":false,"summary":"Create a GitHub Release using host GitHub CLI","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"repo":{"type":"string"},"tag":{"type":"string"},"title":{"type":"string","maxLength":256},"notes":{"type":"string"},"target":{"type":"string"},"draft":{"type":"boolean"},"prerelease":{"type":"boolean"}},"required":["repo","tag"]}}}},"responses":{"200":{"description":"GitHub Release created"},"502":{"description":"GitHub CLI failed or GitHub rejected the release"},"503":{"description":"GitHub CLI is not installed on the host"}}}},
    "/v1/command/run": {"post": {"operationId":"runCommand","x-openai-isConsequential":false,"summary":"Run any shell command directly on the VPS host","description":"Runs /bin/bash -lc on the VPS host as the service account. The service is installed as root, so commands have root privileges. Use this action for host administration, gh, git, systemctl, builds, tests and any other command. Output is capped and execution is timeout-limited.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"command":{"type":"string","description":"Any shell command to run on the VPS host"},"workdir":{"type":"string","description":"Optional host filesystem working directory; absolute paths are supported"},"timeout_seconds":{"type":"integer","minimum":1,"description":"Optional timeout capped by COMMAND_TIMEOUT_SECONDS"}},"required":["command"]}}}},"responses":{"200":{"description":"Command completed; inspect exit_code, stdout, stderr, timed_out and truncated"},"500":{"description":"Command could not be started or workdir is unavailable"}}}}
  }
}
